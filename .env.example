# ==============================================================================
# ULTIMATE WEREWOLF THAI — Environment Variables
# ตั้งค่าตัวแปรเหล่านี้ใน Render.com -> Service -> Environment -> Environment Variables
# ==============================================================================

# 1. Groq API (สมองหลักและตัวปั่นแชทหลักความเร็วสูง)
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Google Gemini API (ผู้ช่วยประมวลผลและระบบสำรองอัตโนมัติ Fallback ผ่าน @google/genai)
# ใน AI Studio ระบบจะฉีด GEMINI_API_KEY ให้อัตโนมัติจาก Secrets panel
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL_PRIMARY="gemini-4-hydrogen"

# 3. Server Configuration
# Render.com จะกำหนดค่า PORT ให้อัตโนมัติ (Local dev ใช้ 3000)
PORT="3000"
APP_URL="http://localhost:3000"
