# ============================================
# Ultimate Werewolf Thai — Environment Config
# Ready for Local Dev & Render.com Deployment
# ============================================

# Server Port (Render.com injects PORT automatically; local defaults to 3000)
PORT="3000"

# Public URL of your deployed app (e.g., https://your-werewolf-app.onrender.com)
APP_URL="MY_APP_URL"

# --- Gemini AI (Primary & Fast Models) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL_PRIMARY="gemini-3.5-flash-lite"
GEMINI_MODEL_FAST="gemini-3.5-flash-lite"

# AI Request Timeout in milliseconds (default 20000ms = 20s to avoid premature cutoffs)
AI_TIMEOUT_MS="20000"

# --- Optional: Additional AI Providers (Failover or Multi-AI Participation) ---
# Priority order when multiple AI keys are provided (Groq is ultra-fast as backup):
# AI_PROVIDER_ORDER="gemini,groq,openrouter,openai,deepseek,anthropic"
# Set to "true" to rotate/mix across all configured AI providers for varied reasoning:
# AI_MIX_PROVIDERS="false"

# OpenAI (optional)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# OpenRouter (optional — supports Claude, Llama, Gemini, GPT, DeepSeek, etc.)
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="google/gemini-2.5-flash"

#Groq (optional — ultra-fast Llama / Mixtral inference)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# DeepSeek (optional)
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"
